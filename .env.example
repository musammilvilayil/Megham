MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=megham
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional
STORAGE_QUOTA_MB=1024          # per-user quota (default 1024)
CRON_SECRET=                   # protects /api/cron/cleanup (Vercel Cron sends it as a Bearer token)
APP_URL=https://your-domain    # used in password reset emails
RESEND_API_KEY=                # email provider for password reset (without it, links are logged server-side)
EMAIL_FROM=MEGHAM <noreply@your-domain>
